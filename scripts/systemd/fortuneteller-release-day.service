[Unit]
Description=FortuneTeller release-day job: log the day's releases and open their pull request

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/snap/bin:/usr/local/bin:/usr/bin:/bin
Environment=FT_MAIN_CHECKOUT=%h/WorkVolume/work/projects/pet/fortuneteller
Environment=FT_JOB_TREE=%h/.local/share/fortuneteller/release-day
ExecStart=%h/WorkVolume/work/projects/pet/fortuneteller/scripts/release-day.sh
TimeoutStartSec=45min
